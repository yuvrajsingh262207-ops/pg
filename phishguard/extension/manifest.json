{
  "manifest_version": 3,
  "name": "PhishGuard Sentinel",
  "version": "3.0.0",
  "description": "Check browser navigation with PhishGuard's local URL analysis service.",
  "permissions": ["storage", "webNavigation", "webRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js", "type": "classic"},
  "action": {"default_popup": "popup.html", "default_title": "PhishGuard Sentinel"},
  "options_page": "options.html"
}
